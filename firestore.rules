        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidUserDirectoryEntry(data) {
      return data.keys().hasAll(['uid', 'displayName', 'accountStatus', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'email', 'registeredAt', 'lastSeenDate',
          'accountStatus', 'suspensionReason', 'role', 'authProvider',
          'language', 'emailVerified', 'offlineSyncState', 'appVersion',
          'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.accountStatus is string && data.accountStatus in ['active', 'suspended'] &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('registeredAt' in data) || (data.registeredAt is string && data.registeredAt.size() <= 25)) &&
        (!('lastSeenDate' in data) || (data.lastSeenDate is string && data.lastSeenDate.size() <= 25)) &&
        (!('suspensionReason' in data) || (data.suspensionReason is string && data.suspensionReason.size() <= 300)) &&
        (!('role' in data) || (data.role is string && data.role in ['user', 'support_moderator', 'admin', 'super_admin'])) &&
        (!('authProvider' in data) || (data.authProvider is string && data.authProvider in ['google.com', 'password'])) &&
        (!('language' in data) || (data.language is string && data.language in ['bn', 'en'])) &&
        (!('emailVerified' in data) || data.emailVerified is bool) &&
        (!('offlineSyncState' in data) || (data.offlineSyncState is string && data.offlineSyncState in ['synced', 'pending', 'error'])) &&
        (!('appVersion' in data) || (data.appVersion is string && data.appVersion.size() <= 40)) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /admins/{adminId} {
      allow get: if isOwner(adminId) && isValidId(adminId);
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidWorkerProfile(incoming()) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidWorkerProfile(incoming()) && isOwner(userId) && isValidId(userId) &&
        (!('userId' in existing()) || existing().userId != userId || incoming().userId == existing().userId) &&
        incoming().userId == userId &&
        (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'photoUrl', 'phone', 'address', 'emergencyContact',
            'factoryName', 'factoryBranch', 'department', 'designation', 'employeeId',
            'employmentType', 'joiningDate', 'salaryGrade', 'basicSalary',
            'houseRentAllowance', 'medicalAllowance', 'transportAllowance',
            'foodAllowance', 'attendanceBonus', 'hasAttendanceBonus',
