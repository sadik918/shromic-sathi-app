        allow update: if isValidSalaryPayment(incoming()) && isOwner(userId) && isValidId(userId) && isValidId(paymentId) &&
          incoming().userId == existing().userId &&
          (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt) &&
