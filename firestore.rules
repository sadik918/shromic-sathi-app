rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password' ||
        request.auth.token.firebase.sign_in_provider == 'phone' ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }
    function isNotDemoAccount() {
      return isSignedIn() && (!('email' in request.auth.token) || request.auth.token.email != 'demo@therate.gmail.com');
    }
    function isOwner(userId) {
      return isVerified() && isNotDemoAccount() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isVerified() && isNotDemoAccount() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          request.auth.token.email == 'sadikulislam45974@gmail.com' &&
          request.auth.token.email_verified == true
        )
      );
    }
    function hasParentProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid;
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidWorkerProfile(data) {
      return data.keys().hasAll([
          'userId', 'fullName', 'photoUrl', 'phone', 'address', 'emergencyContact',
          'factoryName', 'factoryBranch', 'department', 'designation', 'employeeId',
          'employmentType', 'joiningDate', 'salaryGrade', 'basicSalary',
          'houseRentAllowance', 'medicalAllowance', 'transportAllowance',
          'foodAllowance', 'attendanceBonus', 'grossSalary', 'otWageBase',
          'otDivisor', 'otMultiplier', 'effectiveFrom', 'language', 'privacyConsent',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'fullName', 'photoUrl', 'phone', 'address', 'emergencyContact',
          'factoryName', 'factoryBranch', 'department', 'designation', 'employeeId',
          'employmentType', 'joiningDate', 'salaryGrade', 'basicSalary',
          'houseRentAllowance', 'medicalAllowance', 'transportAllowance',
          'foodAllowance', 'attendanceBonus', 'hasAttendanceBonus',
          'attendanceBonusAmount', 'attendanceBonusDays', 'maxConsecutiveAbsences',
          'bonusCutoffTimeEnabled', 'latePenaltyEnabled', 'maxLateDaysForBonus',
          'grossSalary', 'otWageBase', 'otDivisor', 'otMultiplier',
          'otCalculationMode', 'otCustomHourlyRate',
          'shiftPattern', 'dayShiftStartTime', 'nightShiftStartTime', 'rotationStartDate',
          'attendanceWindowStartDay', 'attendanceWindowEndDay',
          'attendanceWindowStartNight', 'attendanceWindowEndNight',
          'dayBonusCutoffTime', 'nightBonusCutoffTime',
          'weeklyHolidayDay', 'expectedPayDay', 'monthlyBudgetTarget', 'openingCashBalance',
          'effectiveFrom', 'language', 'privacyConsent',
          'createdAt', 'updatedAt'
        ]) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.fullName is string && data.fullName.size() <= 120 &&
        data.photoUrl is string && data.photoUrl.size() <= 500000 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.address is string && data.address.size() <= 300 &&
        data.emergencyContact is string && data.emergencyContact.size() <= 120 &&
        data.factoryName is string && data.factoryName.size() <= 150 &&
        data.factoryBranch is string && data.factoryBranch.size() <= 120 &&
        data.department is string && data.department.size() <= 100 &&
        data.designation is string && data.designation.size() <= 100 &&
        data.employeeId is string && data.employeeId.size() <= 60 &&
        data.employmentType is string && data.employmentType.size() <= 30 &&
        data.employmentType in ['permanent', 'probation', 'contractual', 'piece_rate', 'helper', ''] &&
        data.joiningDate is string && data.joiningDate.size() <= 35 &&
        data.salaryGrade is string && data.salaryGrade.size() <= 40 &&
        data.basicSalary is number && data.basicSalary >= 0 && data.basicSalary <= 1000000 &&
        data.houseRentAllowance is number && data.houseRentAllowance >= 0 && data.houseRentAllowance <= 1000000 &&
        data.medicalAllowance is number && data.medicalAllowance >= 0 && data.medicalAllowance <= 500000 &&
        data.transportAllowance is number && data.transportAllowance >= 0 && data.transportAllowance <= 500000 &&
        data.foodAllowance is number && data.foodAllowance >= 0 && data.foodAllowance <= 500000 &&
        data.attendanceBonus is number && data.attendanceBonus >= 0 && data.attendanceBonus <= 500000 &&
        (!('hasAttendanceBonus' in data) || data.hasAttendanceBonus is bool) &&
        (!('attendanceBonusAmount' in data) || (data.attendanceBonusAmount is number && data.attendanceBonusAmount >= 0 && data.attendanceBonusAmount <= 500000)) &&
        (!('attendanceBonusDays' in data) || (data.attendanceBonusDays is number && data.attendanceBonusDays >= 0 && data.attendanceBonusDays <= 31)) &&
        (!('maxConsecutiveAbsences' in data) || (data.maxConsecutiveAbsences is number && data.maxConsecutiveAbsences >= 0 && data.maxConsecutiveAbsences <= 31)) &&
        (!('bonusCutoffTimeEnabled' in data) || data.bonusCutoffTimeEnabled is bool) &&
        (!('latePenaltyEnabled' in data) || data.latePenaltyEnabled is bool) &&
        (!('maxLateDaysForBonus' in data) || (data.maxLateDaysForBonus is number && data.maxLateDaysForBonus >= 0 && data.maxLateDaysForBonus <= 31)) &&
        data.grossSalary is number && data.grossSalary >= 0 && data.grossSalary <= 5000000 &&
        data.otWageBase is string && data.otWageBase.size() <= 20 && data.otWageBase in ['basic', 'gross'] &&
        data.otDivisor is number && data.otDivisor >= 0 && data.otDivisor <= 1000 &&
        data.otMultiplier is number && data.otMultiplier >= 0 && data.otMultiplier <= 10 &&
        (!('otCalculationMode' in data) || (data.otCalculationMode is string && data.otCalculationMode.size() <= 20 && data.otCalculationMode in ['formula', 'manual'])) &&
        (!('otCustomHourlyRate' in data) || (data.otCustomHourlyRate is number && data.otCustomHourlyRate >= 0 && data.otCustomHourlyRate <= 100000)) &&
        (!('shiftPattern' in data) || (data.shiftPattern is string && data.shiftPattern in ['day', 'night', 'weekly_rotation', 'general'])) &&
        (!('dayShiftStartTime' in data) || (data.dayShiftStartTime is string && data.dayShiftStartTime.size() <= 10)) &&
        (!('nightShiftStartTime' in data) || (data.nightShiftStartTime is string && data.nightShiftStartTime.size() <= 10)) &&
        (!('rotationStartDate' in data) || (data.rotationStartDate is string && data.rotationStartDate.size() <= 35)) &&
        (!('attendanceWindowStartDay' in data) || (data.attendanceWindowStartDay is string && data.attendanceWindowStartDay.size() <= 10)) &&
        (!('attendanceWindowEndDay' in data) || (data.attendanceWindowEndDay is string && data.attendanceWindowEndDay.size() <= 10)) &&
        (!('attendanceWindowStartNight' in data) || (data.attendanceWindowStartNight is string && data.attendanceWindowStartNight.size() <= 10)) &&
        (!('attendanceWindowEndNight' in data) || (data.attendanceWindowEndNight is string && data.attendanceWindowEndNight.size() <= 10)) &&
        (!('dayBonusCutoffTime' in data) || (data.dayBonusCutoffTime is string && data.dayBonusCutoffTime.size() <= 10)) &&
        (!('nightBonusCutoffTime' in data) || (data.nightBonusCutoffTime is string && data.nightBonusCutoffTime.size() <= 10)) &&
        (!('weeklyHolidayDay' in data) || (data.weeklyHolidayDay is string && data.weeklyHolidayDay in ['friday', 'saturday', 'sunday', 'monday', 'tuesday', 'wednesday', 'thursday'])) &&
        (!('expectedPayDay' in data) || (data.expectedPayDay is number && data.expectedPayDay >= 0 && data.expectedPayDay <= 31)) &&
        (!('monthlyBudgetTarget' in data) || (data.monthlyBudgetTarget is number && data.monthlyBudgetTarget >= 0 && data.monthlyBudgetTarget <= 5000000)) &&
        (!('openingCashBalance' in data) || (data.openingCashBalance is number && data.openingCashBalance >= -5000000 && data.openingCashBalance <= 50000000)) &&
        data.effectiveFrom is string && data.effectiveFrom.size() <= 35 &&
        data.language is string && data.language.size() <= 10 && data.language in ['bn', 'en'] &&
        data.privacyConsent is bool &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidOvertimeRecord(data) {
      return data.keys().hasAll([
          'userId', 'date', 'month', 'startTime', 'endTime', 'breakMinutes',
          'totalMinutes', 'approvedHours', 'basicSalarySnapshot', 'divisorSnapshot',
          'multiplierSnapshot', 'hourlyRateSnapshot', 'estimatedEarnings', 'notes',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'date', 'month', 'startTime', 'endTime', 'breakMinutes',
          'totalMinutes', 'approvedHours', 'basicSalarySnapshot', 'divisorSnapshot',
          'multiplierSnapshot', 'hourlyRateSnapshot', 'estimatedEarnings', 'notes',
          'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.date is string && data.date.size() <= 15 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.month is string && data.month.size() <= 10 && data.month.matches('^\\d{4}-\\d{2}$') &&
        data.startTime is string && data.startTime.size() <= 10 &&
        data.endTime is string && data.endTime.size() <= 10 &&
        data.breakMinutes is number && data.breakMinutes >= 0 && data.breakMinutes <= 720 &&
        data.totalMinutes is number && data.totalMinutes >= 0 && data.totalMinutes <= 1440 &&
        data.approvedHours is number && data.approvedHours >= 0 && data.approvedHours <= 24 &&
        data.basicSalarySnapshot is number && data.basicSalarySnapshot >= 0 &&
        data.divisorSnapshot is number && data.divisorSnapshot > 0 &&
        data.multiplierSnapshot is number && data.multiplierSnapshot > 0 &&
        data.hourlyRateSnapshot is number && data.hourlyRateSnapshot >= 0 &&
        data.estimatedEarnings is number && data.estimatedEarnings >= 0 &&
        data.notes is string && data.notes.size() <= 300 &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidSalaryRecord(data) {
      return data.keys().hasAll([
          'userId', 'month', 'effectiveDate', 'basicSalary', 'houseRentAllowance',
          'medicalAllowance', 'transportAllowance', 'foodAllowance', 'attendanceBonus',
          'overtimeHours', 'overtimeEarnings', 'festivalBonus', 'otherAllowances',
          'advanceDeduction', 'absenceDeduction', 'otherDeductions', 'adjustments',
          'estimatedGross', 'estimatedNetPayable', 'notes', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'month', 'effectiveDate', 'basicSalary', 'houseRentAllowance',
          'medicalAllowance', 'transportAllowance', 'foodAllowance', 'attendanceBonus',
          'overtimeHours', 'overtimeEarnings', 'festivalBonus', 'otherAllowances',
          'advanceDeduction', 'absenceDeduction', 'otherDeductions', 'adjustments',
          'estimatedGross', 'estimatedNetPayable', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.month is string && data.month.size() <= 10 && data.month.matches('^\\d{4}-\\d{2}$') &&
        data.effectiveDate is string && data.effectiveDate.size() <= 20 &&
        data.basicSalary is number && data.basicSalary >= 0 &&
        data.houseRentAllowance is number && data.houseRentAllowance >= 0 &&
        data.medicalAllowance is number && data.medicalAllowance >= 0 &&
        data.transportAllowance is number && data.transportAllowance >= 0 &&
        data.foodAllowance is number && data.foodAllowance >= 0 &&
        data.attendanceBonus is number && data.attendanceBonus >= 0 &&
        data.overtimeHours is number && data.overtimeHours >= 0 &&
        data.overtimeEarnings is number && data.overtimeEarnings >= 0 &&
        data.festivalBonus is number && data.festivalBonus >= 0 &&
        data.otherAllowances is number && data.otherAllowances >= 0 &&
        data.advanceDeduction is number && data.advanceDeduction >= 0 &&
        data.absenceDeduction is number && data.absenceDeduction >= 0 &&
        data.otherDeductions is number && data.otherDeductions >= 0 &&
        data.adjustments is number &&
        data.estimatedGross is number && data.estimatedGross >= 0 &&
        data.estimatedNetPayable is number &&
        data.notes is string && data.notes.size() <= 400 &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidSalaryPayment(data) {
      return data.keys().hasAll([
          'userId', 'month', 'paymentDate', 'amountReceived', 'paymentMethod',
          'isPartial', 'referenceNote', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'month', 'paymentDate', 'amountReceived', 'paymentMethod',
          'isPartial', 'referenceNote', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.month is string && data.month.size() <= 10 && data.month.matches('^\\d{4}-\\d{2}$') &&
        data.paymentDate is string && data.paymentDate.size() <= 15 &&
        data.amountReceived is number && data.amountReceived >= 0 && data.amountReceived <= 5000000 &&
        data.paymentMethod is string && data.paymentMethod.size() <= 20 &&
        data.paymentMethod in ['cash', 'bkash', 'nagad', 'rocket', 'bank'] &&
        data.isPartial is bool &&
        data.referenceNote is string && data.referenceNote.size() <= 300 &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll([
          'userId', 'date', 'month', 'status', 'leaveCategory',
          'checkIn', 'checkOut', 'notes', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'date', 'month', 'status', 'leaveCategory',
          'checkIn', 'checkOut', 'notes', 'hasAttendanceBonus', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.date is string && data.date.size() <= 15 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.month is string && data.month.size() <= 10 && data.month.matches('^\\d{4}-\\d{2}$') &&
        data.status is string && data.status.size() <= 30 &&
        data.status in ['present', 'absent', 'weekly_holiday', 'public_holiday', 'approved_leave', 'late'] &&
        data.leaveCategory is string && data.leaveCategory.size() <= 30 &&
        data.leaveCategory in ['none', 'casual', 'sick', 'earned', 'maternity', 'festival', 'unpaid'] &&
        data.checkIn is string && data.checkIn.size() <= 10 &&
        data.checkOut is string && data.checkOut.size() <= 10 &&
        data.notes is string && data.notes.size() <= 300 &&
        (!('hasAttendanceBonus' in data) || data.hasAttendanceBonus is bool) &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidExpenseRecord(data) {
      return data.keys().hasAll([
          'userId', 'date', 'month', 'category', 'amount', 'description',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'date', 'month', 'category', 'amount', 'description',
          'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.date is string && data.date.size() <= 15 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.month is string && data.month.size() <= 10 && data.month.matches('^\\d{4}-\\d{2}$') &&
        data.category is string && data.category.size() <= 30 &&
        data.category in ['food', 'rent', 'transport', 'family', 'medical', 'education', 'other'] &&
        data.amount is number && data.amount >= 0 && data.amount <= 5000000 &&
        data.description is string && data.description.size() <= 250 &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidSavingsGoal(data) {
      return data.keys().hasAll([
          'userId', 'title', 'targetAmount', 'savedAmount', 'monthlyBudget',
          'deadline', 'notes', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'title', 'targetAmount', 'savedAmount', 'monthlyBudget',
          'deadline', 'notes', 'storageLocation', 'commissionType', 'commissionAmount',
          'frequency', 'lastDepositDate', 'nextDueDate', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.targetAmount is number && data.targetAmount >= 0 && data.targetAmount <= 50000000 &&
        data.savedAmount is number && data.savedAmount >= 0 && data.savedAmount <= 50000000 &&
        data.monthlyBudget is number && data.monthlyBudget >= 0 && data.monthlyBudget <= 5000000 &&
        data.deadline is string && data.deadline.size() <= 20 &&
        data.notes is string && data.notes.size() <= 250 &&
        (!('storageLocation' in data) || (data.storageLocation is string && data.storageLocation.size() <= 120)) &&
        (!('commissionType' in data) || (data.commissionType is string && data.commissionType in ['commission', 'non_commission'])) &&
        (!('commissionAmount' in data) || (data.commissionAmount is number && data.commissionAmount >= 0 && data.commissionAmount <= 5000000)) &&
        (!('frequency' in data) || (data.frequency is string && data.frequency in ['monthly', 'weekly', 'daily'])) &&
        (!('lastDepositDate' in data) || (data.lastDepositDate is string && data.lastDepositDate.size() <= 20)) &&
        (!('nextDueDate' in data) || (data.nextDueDate is string && data.nextDueDate.size() <= 20)) &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidVaultDocument(data) {
      return data.keys().hasAll([
          'userId', 'title', 'category', 'fileName', 'fileType', 'fileSize',
          'fileData', 'issueDate', 'notes', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'title', 'category', 'fileName', 'fileType', 'fileSize',
          'fileData', 'issueDate', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.category is string && data.category.size() <= 40 &&
        data.category in ['id_card', 'appointment_letter', 'payslip', 'increment_letter', 'leave_approval', 'other'] &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 150 &&
        data.fileType is string && data.fileType.size() <= 60 &&
        data.fileSize is number && data.fileSize >= 0 && data.fileSize <= 524288 &&
        data.fileData is string && data.fileData.size() <= 750000 &&
        data.issueDate is string && data.issueDate.size() <= 20 &&
        data.notes is string && data.notes.size() <= 300 &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidReminderItem(data) {
      return data.keys().hasAll([
          'userId', 'title', 'category', 'dueDate', 'isCompleted',
          'notes', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'title', 'category', 'dueDate', 'isCompleted',
          'notes', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.category is string && data.category.size() <= 30 &&
        data.category in ['salary_date', 'bill_payment', 'monthly_review', 'other'] &&
        data.dueDate is string && data.dueDate.size() <= 15 &&
        data.isCompleted is bool &&
        data.notes is string && data.notes.size() <= 250 &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidPersonalLoan(data) {
      return data.keys().hasAll([
          'userId', 'title', 'totalLoanAmount', 'paidAmount',
          'monthlyInstallment', 'nextDueDate', 'notes', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'title', 'lenderType', 'totalLoanAmount', 'paidAmount',
          'monthlyInstallment', 'nextDueDate', 'notes',
          'personName', 'contactNumber', 'direction', 'originalAmount',
          'transactionDate', 'expectedRepaymentDate', 'reason', 'repaymentArrangement',
          'installmentAmount', 'repaymentFrequency', 'nextInstallmentDate',
          'reminderEnabled', 'status', 'repayments', 'isArchived',
          'createdAt', 'updatedAt'
        ]) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        (!('lenderType' in data) || (data.lenderType is string && data.lenderType.size() <= 30)) &&
        data.totalLoanAmount is number && data.totalLoanAmount >= 0 && data.totalLoanAmount <= 50000000 &&
        data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= 50000000 &&
        data.monthlyInstallment is number && data.monthlyInstallment >= 0 && data.monthlyInstallment <= 5000000 &&
        data.nextDueDate is string && data.nextDueDate.size() <= 20 &&
        data.notes is string && data.notes.size() <= 300 &&
        (!('personName' in data) || (data.personName is string && data.personName.size() <= 100)) &&
        (!('contactNumber' in data) || (data.contactNumber is string && data.contactNumber.size() <= 30)) &&
        (!('direction' in data) || (data.direction is string && data.direction in ['lent', 'borrowed'])) &&
        (!('originalAmount' in data) || (data.originalAmount is number && data.originalAmount >= 0 && data.originalAmount <= 50000000)) &&
        (!('transactionDate' in data) || (data.transactionDate is string && data.transactionDate.size() <= 20)) &&
        (!('expectedRepaymentDate' in data) || (data.expectedRepaymentDate is string && data.expectedRepaymentDate.size() <= 20)) &&
        (!('reason' in data) || (data.reason is string && data.reason.size() <= 300)) &&
        (!('repaymentArrangement' in data) || (data.repaymentArrangement is string && data.repaymentArrangement.size() <= 250)) &&
        (!('installmentAmount' in data) || (data.installmentAmount is number && data.installmentAmount >= 0 && data.installmentAmount <= 5000000)) &&
        (!('repaymentFrequency' in data) || (data.repaymentFrequency is string && data.repaymentFrequency in ['lump_sum', 'weekly', 'monthly', 'custom'])) &&
        (!('nextInstallmentDate' in data) || (data.nextInstallmentDate is string && data.nextInstallmentDate.size() <= 20)) &&
        (!('reminderEnabled' in data) || data.reminderEnabled is bool) &&
        (!('status' in data) || (data.status is string && data.status in ['pending', 'partially_repaid', 'fully_settled', 'overdue', 'due_today', 'archived'])) &&
        (!('repayments' in data) || (data.repayments is list && data.repayments.size() <= 500)) &&
        (!('isArchived' in data) || data.isArchived is bool) &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        data.updatedAt is timestamp;
    }

    function isValidSupportFeedback(data) {
      return data.keys().hasAll([
          'userId', 'workerName', 'category', 'message', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'workerName', 'category', 'message', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.workerName is string && data.workerName.size() <= 120 &&
        data.category is string && data.category.size() <= 40 &&
        data.category in ['calculation_help', 'bug_report', 'feature_request', 'general'] &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
        data.status is string && data.status.size() <= 20 &&
        data.status in ['open', 'resolved'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGarmentWorkplace(data) {
      return data.keys().hasAll([
          'userId', 'factoryName', 'isCurrent', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'factoryName', 'factoryAddress', 'factoryArea', 'department',
          'floorNumber', 'lineNumber', 'designation', 'employeeId', 'supervisorName',
          'joiningDate', 'leavingDate', 'leavingReason', 'shiftPattern',
          'grossSalary', 'basicSalary', 'totalReceivedSalary', 'totalExpectedSalary',
          'totalOvertimeHours', 'totalOvertimeEarnings', 'totalPresentDays',
          'totalAbsentDays', 'totalLeaveDays', 'monthsWorked',
          'factoryPhone', 'notes', 'isCurrent', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.factoryName is string && data.factoryName.size() >= 1 && data.factoryName.size() <= 150 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('factoryAddress' in data) || (data.factoryAddress is string && data.factoryAddress.size() <= 250)) &&
        (!('factoryArea' in data) || (data.factoryArea is string && data.factoryArea.size() <= 100)) &&
        (!('department' in data) || (data.department is string && data.department.size() <= 100)) &&
        (!('floorNumber' in data) || (data.floorNumber is string && data.floorNumber.size() <= 50)) &&
        (!('lineNumber' in data) || (data.lineNumber is string && data.lineNumber.size() <= 50)) &&
        (!('designation' in data) || (data.designation is string && data.designation.size() <= 100)) &&
        (!('employeeId' in data) || (data.employeeId is string && data.employeeId.size() <= 60)) &&
        (!('supervisorName' in data) || (data.supervisorName is string && data.supervisorName.size() <= 100)) &&
        (!('joiningDate' in data) || (data.joiningDate is string && data.joiningDate.size() <= 20)) &&
        (!('leavingDate' in data) || (data.leavingDate is string && data.leavingDate.size() <= 20)) &&
        (!('leavingReason' in data) || (data.leavingReason is string && data.leavingReason.size() <= 200)) &&
        (!('shiftPattern' in data) || (data.shiftPattern is string && data.shiftPattern in ['day', 'night', 'weekly_rotation', 'general'])) &&
        (!('grossSalary' in data) || (data.grossSalary is number && data.grossSalary >= 0 && data.grossSalary <= 5000000)) &&
        (!('basicSalary' in data) || (data.basicSalary is number && data.basicSalary >= 0 && data.basicSalary <= 1000000)) &&
        (!('totalReceivedSalary' in data) || (data.totalReceivedSalary is number && data.totalReceivedSalary >= 0)) &&
        (!('totalExpectedSalary' in data) || (data.totalExpectedSalary is number && data.totalExpectedSalary >= 0)) &&
        (!('totalOvertimeHours' in data) || (data.totalOvertimeHours is number && data.totalOvertimeHours >= 0)) &&
        (!('totalOvertimeEarnings' in data) || (data.totalOvertimeEarnings is number && data.totalOvertimeEarnings >= 0)) &&
        (!('totalPresentDays' in data) || (data.totalPresentDays is number && data.totalPresentDays >= 0)) &&
        (!('totalAbsentDays' in data) || (data.totalAbsentDays is number && data.totalAbsentDays >= 0)) &&
        (!('totalLeaveDays' in data) || (data.totalLeaveDays is number && data.totalLeaveDays >= 0)) &&
        (!('monthsWorked' in data) || (data.monthsWorked is number && data.monthsWorked >= 0)) &&
        (!('factoryPhone' in data) || (data.factoryPhone is string && data.factoryPhone.size() <= 30)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.isCurrent is bool &&
        data.updatedAt is timestamp;
    }

    function isValidWorkerContact(data) {
      return data.keys().hasAll([
          'userId', 'fullName', 'phone', 'category', 'isFavorite', 'isEmergency', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'fullName', 'phone', 'photoUrl', 'designation',
          'category', 'customCategory', 'department', 'lineNumber', 'notes',
          'isPinned', 'isFavorite', 'isEmergency', 'source',
          'googleResourceName', 'isSyncedToGoogle', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 30 &&
        data.category is string && data.category in ['supervisor', 'line_chief', 'production_manager', 'hr_admin', 'security', 'coworker', 'emergency', 'other', 'google'] &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 100000)) &&
        (!('customCategory' in data) || (data.customCategory is string && data.customCategory.size() <= 100)) &&
        (!('designation' in data) || (data.designation is string && data.designation.size() <= 100)) &&
        (!('department' in data) || (data.department is string && data.department.size() <= 100)) &&
        (!('lineNumber' in data) || (data.lineNumber is string && data.lineNumber.size() <= 50)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
        (!('isPinned' in data) || data.isPinned is bool) &&
        (!('source' in data) || (data.source is string && data.source in ['google', 'manual'])) &&
        (!('googleResourceName' in data) || (data.googleResourceName is string && data.googleResourceName.size() <= 200)) &&
        (!('isSyncedToGoogle' in data) || data.isSyncedToGoogle is bool) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        data.isFavorite is bool &&
        data.isEmergency is bool &&
        data.updatedAt is timestamp;
    }

    function isValidAlarmItem(data) {
      return data.keys().hasAll([
          'userId', 'time', 'label', 'isEnabled', 'repeatDays', 'toneId', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'time', 'label', 'isEnabled', 'repeatDays', 'toneId',
          'customToneName', 'customToneId', 'lastTriggeredDate', 'createdAt', 'updatedAt'
