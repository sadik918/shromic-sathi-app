          hasParentProfile(userId);
        allow update: if isValidPersonalLoan(incoming()) && isOwner(userId) && isValidId(userId) && isValidId(loanId) &&
          incoming().userId == existing().userId &&
          (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt) &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'id', 'title', 'lenderType', 'totalLoanAmount', 'paidAmount', 'monthlyInstallment', 'nextDueDate', 'notes',
            'personName', 'contactNumber', 'direction', 'originalAmount', 'transactionDate', 'expectedRepaymentDate',
            'reason', 'repaymentArrangement', 'installmentAmount', 'repaymentFrequency', 'nextInstallmentDate',
            'reminderEnabled', 'status', 'repayments', 'isArchived', 'updatedAt'
          ]) &&
          hasParentProfile(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(loanId) && hasParentProfile(userId);
      }

      // Subcollection: Workplace History
      match /workplaces/{workplaceId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(workplaceId) && hasParentProfile(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(workplaceId) &&
          isValidGarmentWorkplace(incoming()) &&
          incoming().updatedAt == request.time &&
          (!('createdAt' in incoming()) || incoming().createdAt == request.time) &&
          hasParentProfile(userId);
        allow update: if isValidGarmentWorkplace(incoming()) && isOwner(userId) && isValidId(userId) && isValidId(workplaceId) &&
          incoming().userId == existing().userId &&
          (!('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt) &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'id', 'factoryName', 'factoryAddress', 'factoryArea', 'department',
            'floorNumber', 'lineNumber', 'designation', 'employeeId', 'supervisorName',
            'joiningDate', 'leavingDate', 'leavingReason', 'shiftPattern',
            'grossSalary', 'basicSalary', 'totalReceivedSalary', 'totalExpectedSalary',
            'totalOvertimeHours', 'totalOvertimeEarnings', 'totalPresentDays',
            'totalAbsentDays', 'totalLeaveDays', 'monthsWorked',
            'factoryPhone', 'notes', 'isCurrent', 'updatedAt'
          ]) &&
          hasParentProfile(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(workplaceId) && hasParentProfile(userId);
      }

      // Subcollection: Personal Contact Book
      match /contacts/{contactId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(contactId) && hasParentProfile(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(contactId) &&
          isValidWorkerContact(incoming()) &&
          incoming().updatedAt == request.time &&
          (!('createdAt' in incoming()) || incoming().createdAt == request.time) &&
          hasParentProfile(userId);
        allow update: if isValidWorkerContact(incoming()) && isOwner(userId) && isValidId(userId) && isValidId(contactId) &&
          incoming().userId == existing().userId &&
          (!('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt) &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'id', 'fullName', 'phone', 'photoUrl', 'designation', 'category',
            'customCategory', 'department', 'lineNumber', 'notes', 'isPinned',
            'isFavorite', 'isEmergency', 'source', 'googleResourceName',
            'isSyncedToGoogle', 'updatedAt'
          ]) &&
          hasParentProfile(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(contactId) && hasParentProfile(userId);
      }

      // Subcollection: Duty Alarms
      match /alarms/{alarmId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(alarmId) && hasParentProfile(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(alarmId) &&
          isValidAlarmItem(incoming()) &&
          incoming().createdAt == request.time && incoming().updatedAt == request.time &&
          hasParentProfile(userId);
        allow update: if isValidAlarmItem(incoming()) && isOwner(userId) && isValidId(userId) && isValidId(alarmId) &&
          incoming().userId == existing().userId &&
          (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || incoming().createdAt == existing().createdAt) &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'time', 'label', 'isEnabled', 'repeatDays', 'toneId',
            'customToneName', 'customToneId', 'lastTriggeredDate', 'updatedAt'
          ]) &&
          hasParentProfile(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(alarmId) && hasParentProfile(userId);
      }
    }

    // Support & Feedback Collection
    match /feedback/{feedbackId} {
      allow get: if isValidId(feedbackId) && (isOwner(existing().userId) || isAdmin());
      allow list: if (isVerified() && existing().userId == request.auth.uid) || isAdmin();
      allow create: if isValidId(feedbackId) && isOwner(incoming().userId) &&
        isValidSupportFeedback(incoming()) &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidSupportFeedback(incoming()) && isValidId(feedbackId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isOwner(existing().userId) &&
            existing().status != 'resolved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['message', 'category', 'updatedAt'])
          )
        );
      allow delete: if isValidId(feedbackId) && (isOwner(existing().userId) || isAdmin());
    }

    // Non-Financial User Directory for Admin Account Status Management
    match /userDirectory/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isValidUserDirectoryEntry(incoming()) &&
        incoming().updatedAt == request.time &&
        (!('createdAt' in incoming()) || incoming().createdAt == request.time) && (
          (
            isOwner(userId) &&
            incoming().uid == userId &&
            incoming().accountStatus == 'active' &&
            (!('role' in incoming()) || incoming().role == 'user') &&
            !('suspensionReason' in incoming())
          ) ||
          isAdmin()
        );
      allow update: if isValidId(userId) &&
        isValidUserDirectoryEntry(incoming()) &&
        incoming().uid == existing().uid &&
        (!('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time && (
          (
            isOwner(userId) &&
            incoming().accountStatus == existing().accountStatus &&
            ((!('role' in existing()) && !('role' in incoming())) || ('role' in existing() && 'role' in incoming() && incoming().role == existing().role)) &&
            ((!('suspensionReason' in existing()) && !('suspensionReason' in incoming())) || ('suspensionReason' in existing() && 'suspensionReason' in incoming() && incoming().suspensionReason == existing().suspensionReason)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'email', 'lastSeenDate', 'authProvider',
              'language', 'emailVerified', 'offlineSyncState', 'appVersion', 'updatedAt'
            ])
          ) ||
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'email', 'accountStatus', 'suspensionReason',
              'role', 'offlineSyncState', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // Platform Announcements
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && (isSignedIn() || isAdmin());
      allow list: if (isSignedIn() && existing().status == 'published') || isAdmin();
      allow create, update: if isAdmin() && isValidId(announcementId) &&
        incoming().keys().hasAll(['titleBn', 'messageBn', 'category', 'status', 'updatedAt']) &&
        incoming().titleBn is string && incoming().titleBn.size() >= 1 && incoming().titleBn.size() <= 200 &&
        incoming().messageBn is string && incoming().messageBn.size() >= 1 && incoming().messageBn.size() <= 1500 &&
        incoming().category in ['general', 'maintenance', 'new_feature', 'security', 'important_update'] &&
        incoming().status in ['draft', 'published', 'archived'] &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Immutable Administrative Audit Logs (Append-Only)
    match /auditLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) &&
        incoming().keys().hasAll(['actorUid', 'actionType', 'targetId', 'reason', 'createdAt']) &&
        incoming().keys().hasOnly(['actorUid', 'actionType', 'targetId', 'reason', 'createdAt']) &&
        incoming().actorUid == request.auth.uid &&
        incoming().actorUid is string && incoming().actorUid.size() <= 128 &&
        incoming().actionType is string && incoming().actionType.size() >= 1 && incoming().actionType.size() <= 60 &&
        incoming().targetId is string && incoming().targetId.size() >= 1 && incoming().targetId.size() <= 128 &&
        incoming().reason is string && incoming().reason.size() >= 1 && incoming().reason.size() <= 400 &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Publicly Readable, Super Admin Writable Demo System Configuration
    match /demoConfig/{configId} {
      allow get: if isValidId(configId);
      allow list: if false;
      allow create, update: if isAdmin() && isValidId(configId) &&
        incoming().keys().hasAll(['enabled', 'demoEmail', 'maintenanceMessageBn', 'updatedAt']) &&
        incoming().keys().hasOnly(['enabled', 'demoEmail', 'maintenanceMessageBn', 'maintenanceMessageEn', 'lastResetAt', 'updatedAt']) &&
        incoming().enabled is bool &&
        incoming().demoEmail is string && incoming().demoEmail.size() >= 3 && incoming().demoEmail.size() <= 120 &&
        incoming().maintenanceMessageBn is string && incoming().maintenanceMessageBn.size() >= 1 && incoming().maintenanceMessageBn.size() <= 400 &&
        (!('maintenanceMessageEn' in incoming()) || (incoming().maintenanceMessageEn is string && incoming().maintenanceMessageEn.size() <= 400)) &&
        (!('lastResetAt' in incoming()) || (incoming().lastResetAt is string && incoming().lastResetAt.size() <= 40)) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Subscription & Plan Configuration (Publicly readable, Admin manageable)
    match /subscriptionConfig/{configId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(configId);
    }

    // User Subscriptions (Owner can only submit upgrade request; Admin manages plan grants)
    match /userSubscriptions/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().userId == userId &&
          incoming().planId == 'starter_free' &&
          incoming().status == 'free' &&
          (!('tier' in incoming()) || incoming().tier == 'starter_free') &&
          (!('isComplimentary' in incoming()) || incoming().isComplimentary == false)
        )
      );
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().userId == existing().userId &&
          incoming().planId == existing().planId &&
          incoming().status == existing().status &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'pendingRequest', 'updatedAt', 'userEmail', 'userDisplayName'
          ])
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
