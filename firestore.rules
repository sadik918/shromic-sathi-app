        data.time is string && data.time.size() >= 4 && data.time.size() <= 10 &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 150 &&
        data.isEnabled is bool &&
        data.repeatDays is list && data.repeatDays.size() <= 7 &&
        data.toneId is string && data.toneId in ['factory_siren', 'digital_beep', 'gentle_chime', 'morning_bell', 'custom_device'] &&
        (!('customToneName' in data) || (data.customToneName is string && data.customToneName.size() <= 120)) &&
        (!('customToneId' in data) || (data.customToneId is string && data.customToneId.size() <= 128)) &&
